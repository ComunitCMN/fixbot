# ============ Telegram ============
# Токен от @BotFather. Не забудьте выключить Group Privacy!
TELEGRAM_TOKEN=123456:AA...

# ОПЕРАТОР — тот, кто держит бота на сервере (вы). Видит техническое:
# воронки amoCRM, синхронизацию, диагностику. Свой ID узнать у @userinfobot.
OPERATOR_IDS=

# ВЛАДЕЛЕЦ — застройщик, для которого бот работает. Видит рассылки,
# группы, агентства и статистику. Токенов и воронок не видит.
# Своих сотрудников он добавляет сам через меню, вам приходит уведомление.
OWNER_IDS=

# Старое название роли, понимается как ОПЕРАТОР. Оставлено для совместимости.
ADMIN_IDS=

# Пусто = работать во всех чатах, куда добавили. Иначе список через запятую.
ALLOWED_CHATS=

# ============ Claude API ============
# console.anthropic.com -> API keys
ANTHROPIC_API_KEY=sk-ant-...
MODEL=claude-haiku-4-5-20251001
# Ниже этого порога уверенности фиксация игнорируется.
# Порог низкий намеренно: запись в amoCRM всё равно требует подтверждения
# кнопкой, поэтому лишний вопрос дешевле пропущенной фиксации.
MIN_CONFIDENCE=0.3

# Через сколько минут снимать карточку подтверждения, если никто не нажал
CONFIRM_TTL_MIN=60

# Как часто проверять, не сдвинулись ли сделки в amoCRM, минут.
# По изменениям бот шлёт агентам уведомления в личку.
STATUS_CHECK_MIN=10

# ============ amoCRM ============
# Если аккаунт на https://romashka.amocrm.ru -> romashka
AMO_SUBDOMAIN=romashka

# Способ авторизации: long_lived (по умолчанию) или oauth
AMO_AUTH=long_lived

# --- вариант 1: долгосрочный токен (проще, работает локально) ---
# Настройки -> Интеграции -> своя интеграция -> Ключи и доступы
AMO_LONG_TOKEN=eyJ0eXAiOi...

# --- вариант 2: OAuth (нужен для чужих аккаунтов) ---
# Требует публичный HTTPS-адрес, на локальном компьютере НЕ заработает.
# Переключить: AMO_AUTH=oauth
AMO_CLIENT_ID=
AMO_CLIENT_SECRET=
AMO_REDIRECT_URI=

# Куда класть новые агентские сделки. Пусто = воронка по умолчанию.
# ID видно в /pipelines или через GET /api/v4/leads/pipelines
AMO_PIPELINE_ID=
AMO_STATUS_ID=
# ID кастомного поля телефона, если не используется стандартное
AMO_PHONE_FIELD_ID=

# 1 = писать агентство ещё и в карточку клиента.
# По умолчанию 0: агентство висит только на сделке, чтобы поле «Компания»
# у клиента не превращалось в «кто его привёл».
LINK_AGENCY_TO_CONTACT=0

# ============ Поведение ============
DB_PATH=fixbot.db
# Как часто перевыгружать базу amoCRM, минут
SYNC_INTERVAL_MIN=30

# 1 = на каждой проверке дополнительно спрашивать amoCRM вживую.
# Убирает слепую зону: контакты, созданные после последней синхронизации,
# бот увидит сразу. Цена — примерно секунда задержки на сообщение.
# Зеркало при этом остаётся: оно надёжнее ищет по маскированным номерам.
LIVE_LOOKUP=1

# Через сколько дней без активности клиент отдела продаж считается
# остывшим и снова доступен агентствам
RETAIL_TTL_DAYS=365

# Страна для номеров, записанных БЕЗ международного кода.
# «8 999…» при RU прочтётся как российский, «0812…» при ID — как индонезийский.
# Номера с «+» разбираются сами, эта настройка на них не влияет.
# Для отдельного чата переопределяется командой /region — например,
# в чате про Бали имеет смысл поставить ID.
DEFAULT_REGION=RU

# Язык, когда в сообщении нет букв (например, прислали только номер).
# Обычно бот отвечает на языке того сообщения, на которое реагирует:
# написали по-русски — ответит по-русски, по-английски — по-английски.
# Прибить язык конкретной группы: /lang en
DEFAULT_LANG=ru

# Название вашего застройщика. Нужно, чтобы вычленить агентство из имени
# совместного чата: «TEUS & Squaresell» → предложит агентство TEUS.
DEVELOPER_NAME=

# 1 = молчать на нефиксациях, 0 = отвечать почему пропустил (для отладки правил)
QUIET=1

# 1 = показывать в чате ссылки на карточки в amoCRM.
# По умолчанию 0: у агентов из сторонних агентств доступа к вашей CRM нет,
# для них это просто мусор в сообщении.
SHOW_CRM_LINKS=0

# РЕЖИМ НАБЛЮДЕНИЯ. 1 = бот всё считает и отвечает в чат, но НИЧЕГО не пишет
# в amoCRM. Включи на первую неделю в реальных чатах: увидишь, где он ошибается,
# и поправишь правила — без мусора в CRM. Потом поставь 0.
DRY_RUN=0

# ============ Только для оператора ============
# Папка, где лежат клиенты: clients/<имя>/.env и своя база у каждого.
# Нужна для раздела «Мои клиенты» и для кнопки «Развернуть». Клиентам
# эту строку заполнять не надо — она только у того, кто держит сервер.
# На сервере обычно /opt/fixbot/clients
CLIENTS_DIR=
