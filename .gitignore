# Секреты — никогда не должны попасть в историю версий.
# Здесь лежат токены бота, amoCRM и Claude.
.env
clients/*/.env

# Базы данных: справочник агентств, реестр агентов, журнал фиксаций.
# Это данные, а не код — им место в резервных копиях, не в git.
*.db
*.db-journal
*.db-wal
*.db-shm

# Логи
*.log

# Окружение Python и служебные файлы
venv/
__pycache__/
*.pyc
.pytest_cache/
.DS_Store
